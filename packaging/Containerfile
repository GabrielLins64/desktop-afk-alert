FROM ghcr.io/astral-sh/uv:0.8.8 AS uv
FROM ghcr.io/goreleaser/nfpm:v2.47.0 AS nfpm
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates build-essential ccache python3-dev python3-venv patchelf \
    libffi-dev libwayland-dev libxkbcommon-dev libxkbcommon-x11-dev \
    libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-render-util0 libxcb-xkb1 libxcb-shape0 libxrandr2 libegl1 libgl1 libdbus-1-3 \
    libasound2t64 libpulse0 libglib2.0-0t64 libfontconfig1 libfreetype6 libgssapi-krb5-2 sudo \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=nfpm /usr/bin/nfpm /usr/local/bin/nfpm
ENV UV_PYTHON=/usr/bin/python3 UV_LINK_MODE=copy
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.cache scripts/build.sh && scripts/package.sh
CMD ["/bin/bash"]
