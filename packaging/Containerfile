FROM ghcr.io/astral-sh/uv:0.8.8 AS uv
FROM ghcr.io/goreleaser/nfpm:v2.47.0 AS nfpm
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
COPY scripts/install-deps.sh /tmp/install-deps.sh
RUN bash /tmp/install-deps.sh && rm -rf /var/lib/apt/lists/* /tmp/install-deps.sh
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=nfpm /usr/bin/nfpm /usr/local/bin/nfpm
# Ubuntu 22.04 ships Python 3.10; bundle a managed Python 3.11 runtime instead.
ENV UV_PYTHON=3.11 UV_PYTHON_PREFERENCE=only-managed UV_LINK_MODE=copy
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,id=desktop-afk-alert-ubuntu-22.04,target=/root/.cache scripts/build.sh && scripts/package.sh
CMD ["/bin/bash"]
